# more about time units: https://pkg.go.dev/time#ParseDuration

# APPS
APPS_NAME="Employee Management API"
APPS_VERSION="1.0.0"
APPS_DESCRIPTION="API which can manage employee"

# SERVER
SERVER_PORT=8080

# DATABASE SQL
DATABASE_MYSQL_HOST="mysql"
DATABASE_MYSQL_PORT="3306"
DATABASE_MYSQL_NAME=""
DATABASE_MYSQL_USERNAME=""
DATABASE_MYSQL_PASSWORD=""
DATABASE_MYSQL_CONNECTION_TIMEOUT="20s"
DATABASE_MYSQL_MAX_IDLE_CONNECTION=5
DATABASE_MYSQL_MAX_OPEN_CONNECTION=10
DATABASE_MYSQL_DEBUG_MODE=false

# DATABASE SEEDER SQL
DATABASE_SEEDER_MYSQL_USER_IS_REBUILD_DATA=false
DATABASE_SEEDER_MYSQL_ROLE_IS_REBUILD_DATA=false

# DATABASE CACHE
DATABASE_CACHE_REDIS_ADDRESS="redis:6379"
DATABASE_CACHE_REDIS_USERNAME=""
DATABASE_CACHE_REDIS_PASSWORD=""
DATABASE_CACHE_REDIS_DATABASE=

# PASSWORD HASHING
PASSWORD_HASHING_HASH_SALT=14

# JWT
JWT_SECRET_KEY=""
JWT_EXPIRED_DURATION="72h"